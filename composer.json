{
    "name": "contatta/qless-php",
    "description": "qless client implementation for PHP",
    "license": "MIT",
    "authors": [
        {
            "name": "contatta",
            "email": "dev@contatta.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-redis": "*",
        "ext-sockets": "*",
        "psr/log": "~1.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "~3.95",
        "phpunit/phpunit": "~9.6"
    },
    "autoload": {
        "psr-4": {
            "Qless\\": "lib/Qless/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
