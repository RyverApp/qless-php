{
    "name": "ryverapp/qless-php",
    "description": "qless client implementation for PHP",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Nathan Baulch",
            "email": "nathan@ryver.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-posix": "*",
        "ext-redis": "*",
        "ext-sockets": "*",
        "psr/log": "~3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "~3.95",
        "phpstan/phpstan": "~2.2",
        "phpunit/phpunit": "~11.5",
        "symfony/http-client": "~7.4",
        "testcontainers/testcontainers": "~1.2",
        "rector/rector": "~2.7"
    },
    "autoload": {
        "psr-4": {
            "Qless\\": "lib/Qless/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.2"
        }
    }
}
